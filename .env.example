# Set a long random secret in production. Do not commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
# Required to accept external GPS tracking-device updates at POST /api/tracking/location
TRACKING_API_TOKEN=replace-with-a-different-long-random-token
# Set COOKIE_SECURE=1 only when served over HTTPS
COOKIE_SECURE=0
# Optional local database path
# JOY_DB_PATH=/absolute/path/to/joy_bus.db
PORT=5000
